<adapter-config xsdTargetNamespace="http://xmlns.oracle.com/cloud/adapter/REST/runagenticreactpattern_REQUEST/types" name="runagenticreactpattern_REQUESTPortType" adapter="REST" wsdlLocation="runagenticreactpattern_REQUEST.wsdl" xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">
  <connection-factory location="cloud/CloudAdapter">
    <non-managed-connection managedConnectionFactoryClassName="oracle.cloud.connector.rest.RestAdapterConnectionFactory">
      <property name="cloud.adapter.plugin.version" value="25.06.0"/>
      <property name="cloud.adapter.sdk.version" value="25.06.0"/>
      <property name="rest.inbound.security.configurable" value="true"/>
      <property name="security" value="oracle/multi_token_rest_service_policy"/>
      <property name="securityPolicy" value="MULTI_TOKEN_INBOUND"/>
    </non-managed-connection>
  </connection-factory>
  <endpoint-activation portType="runagenticreactpattern_REQUESTPortType" operation="execute">
    <activation-spec className="oracle.tip.adapter.cloud.CloudActivationSpec">
      <property name="targetOperation" value="execute"/>
      <property name="HTTPHeadersAdded" value="true"/>
      <property name="HttpVerb" value="POST"/>
      <property name="QueryParameters" value="conversationId, isCallback"/>
      <property name="RequestElementNS" value="http://xmlns.oracle.com/cloud/adapter/REST/runagenticreactpattern/types"/>
      <property name="RequestElementName" value="request-wrapper"/>
      <property name="RequestMediaType" value="application/json"/>
      <property name="RequestSample" value="{   &quot;prompt&quot; : &quot;shruhtilaya!!!&quot;,   &quot;agentRole&quot; : &quot;Your role is to say hello to users&quot;,   &quot;agentGuideline&quot; : &quot;Call the hello tool with the input name and respond the user with the hello greetings returned by the tool&quot;,   &quot;patternRoles&quot; : [ {     &quot;patternRole&quot; : &quot;Default&quot;,     &quot;patternGuideline&quot; : &quot;- Strictly follow all guidelines. It is mandatory that you reflect on all guidelines provided.\n1. You should follow the ReAct agent pattern (Reason + Act) when generating a response.\nPattern:\n-- Think - using your internal reasoning.\n-- Action - Invoke tools to get information, including additional human input.\n-- Observe - Process tool response using your internal reasoning.\n-- Repeat - Repeat until finished.\n2. At each step you provide your think, action, and observe rationale.\n3. You should always attempt to get the most relevant information based on tool use.\n4. Do not guess or infer tool arguments except for the following reasons:\n- You are given specific guidance by the tool on inferring a tool argument.\n- You have previous context to make a reasonable assumption.\n&quot;,     &quot;patternMaxIteration&quot; : 10,     &quot;patternTemperature&quot; : 0.5,     &quot;toolJsonString&quot; : &quot;[{\&quot;type\&quot;:\&quot;function\&quot;,\&quot;function\&quot;:{\&quot;name\&quot;:\&quot;Hello Tool\&quot;,\&quot;description\&quot;:\&quot;Hello Tool \&quot;,\&quot;parameters\&quot;:{\&quot;type\&quot;:\&quot;object\&quot;,\&quot;properties\&quot;:{\&quot;name\&quot;:{\&quot;type\&quot;:\&quot;string\&quot;,\&quot;x-visible\&quot;:true}},\&quot;required\&quot;:[\&quot;name\&quot;]}}}]&quot;,     &quot;toolDetails&quot; : [ {       &quot;toolId&quot; : &quot;HELLO_TOOL&quot;,       &quot;toolName&quot; : &quot;Hello Tool&quot;,       &quot;toolGuideline&quot; : &quot;Receives a name parameter and appends hello greeting before the name&quot;,       &quot;async&quot; : false,       &quot;toolDescription&quot; : &quot;Hello Tool &quot;     }, {       &quot;toolId&quot; : &quot;HELLO_TOOL_1&quot;,       &quot;toolName&quot; : &quot;Hello Tool&quot;,       &quot;toolGuideline&quot; : &quot;Receives a name parameter and appends hello greeting before the name&quot;,       &quot;async&quot; : false,       &quot;toolDescription&quot; : &quot;Hello Tool &quot;     } ]   } ],   &quot;output&quot; : &quot;&quot;,   &quot;agentEndpointURI&quot; : &quot;&quot;,   &quot;agentId&quot; : &quot;&quot;,   &quot;projectId&quot; : &quot;&quot; }"/>
      <property name="ResourceURI" value="/start"/>
      <property name="activationSpecClass" value="oracle.tip.adapter.cloud.CloudActivationSpec"/>
      <property name="allowChangeDefaultNamespace" value="false"/>
      <property name="copyFaultFromModel" value="true"/>
      <property name="forceWsdlTypesBuild" value="true"/>
      <property name="generateConnectivityPropertiesInboundRequest" value="RESTINREQ"/>
      <property name="generateConnectivityPropertiesInboundResponse" value="RESTINRES"/>
      <property name="generateInboundCredentials" value="true"/>
      <property name="generatePartnerLink" value="false"/>
      <property name="generateSecurityPropertiesInboundRequest" value="SECURITYPROPSRESTINREQ"/>
      <property name="integrationSchemaNamespace" value="http://xmlns.oracle.com/cloud/adapter/REST/runagenticreactpattern_REQUEST/types"/>
      <property name="integrationWSDLNamespace" value="http://xmlns.oracle.com/cloud/adapter/REST/runagenticreactpattern_REQUEST"/>
      <property name="invocationStyle" value="NOTIFICATION"/>
      <property name="isRequestJsonSchema" value="false"/>
      <property name="isRequestRawBytes" value="false"/>
      <property name="operations" value="default"/>
      <property name="postQueryParamsAsContent" value="false"/>
      <property name="requestJsonTopLevelArray" value="false"/>
    </activation-spec>
  </endpoint-activation>
</adapter-config>
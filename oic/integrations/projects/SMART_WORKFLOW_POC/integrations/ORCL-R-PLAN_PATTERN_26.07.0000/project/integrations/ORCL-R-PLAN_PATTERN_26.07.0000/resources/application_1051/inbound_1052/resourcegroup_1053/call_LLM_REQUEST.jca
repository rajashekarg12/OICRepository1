<adapter-config xsdTargetNamespace="http://xmlns.oracle.com/cloud/adapter/oracle:openai/call_LLM/types" name="call_LLM_REQUESTPortType" adapter="oracle:openai" wsdlLocation="call_LLM_REQUEST.wsdl" xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">

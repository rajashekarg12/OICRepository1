<adapter-config xsdTargetNamespace="http://xmlns.oracle.com/cloud/adapter/soap/hellotest_REQUEST/types" name="TestPortType" adapter="soap" wsdlLocation="hellotest_REQUEST.wsdl" xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">
  <connection-factory location="cloud/CloudAdapter">
    <non-managed-connection managedConnectionFactoryClassName="oracle.cloud.connector.soap.SoapConnectionFactory">
      <property name="applicationVersion" value="1_0"/>
      <property name="cloud.adapter.plugin.version" value="24.10.1"/>
      <property name="cloud.adapter.sdk.version" value="24.10.1"/>
      <property name="endpointURL" value="http://www.example.org/mock/service"/>
      <property name="managedSecurity" value="true"/>
      <property name="privateEndpoint" value="false"/>
      <property name="security" value="NONE"/>
      <property name="targetWSDLURL" value="%%SOAP_TEST_targetWSDLURL"/>
    </non-managed-connection>
  </connection-factory>
  <endpoint-interaction portType="TestPortType" operation="SayHello" onpremise="true" agent="GROUP1">
    <interaction-spec className="oracle.tip.adapter.cloud.CloudInteractionSpec">
      <property name="targetOperation" value="SayHello"/>
      <property name="operationPath" value="http://www.example.org/TestService/SayHello"/>
      <property name="enforceResponseSizeRestriction" value="true"/>
      <property name="oic.gen3.invoke" value="true"/>
      <property name="dynamicInvokeEnabled" value="true"/>
      <property name="enableMTOMProcessing" value="false"/>
      <property name="endpointWSDLURL" value="hellotest_REQUEST.wsdl"/>
      <property name="generatePartnerLink" value="false"/>
      <property name="inboundAsyncEnabled" value="false"/>
      <property name="jcaTransportEnabled" value="true"/>
      <property name="skipAttachmentProcessing" value="true"/>
      <property name="targetInvocationStyle" value="REQUEST_RESPONSE"/>
      <property name="targetPort" value="TestPort"/>
      <property name="targetService" value="TestService"/>
    </interaction-spec>
  </endpoint-interaction>
</adapter-config>